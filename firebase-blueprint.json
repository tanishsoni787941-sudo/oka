{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "student_id": {
          "type": "string"
        },
        "profile_photo": {
          "type": "string"
        },
        "active_device_id": {
          "type": "string"
        },
        "created_at": {
          "type": "number"
        }
      },
      "required": ["id", "full_name", "email", "student_id", "active_device_id", "created_at"]
    },
    "Progress": {
      "title": "Progress",
      "description": "User progress for a lesson",
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "lesson_id": {
          "type": "string"
        },
        "completed": {
          "type": "boolean"
        },
        "completion_date": {
          "type": "number"
        }
      },
      "required": ["user_id", "lesson_id", "completed", "completion_date"]
    },
    "Metadata": {
      "title": "Metadata",
      "description": "Global metadata like counters",
      "type": "object",
      "properties": {
        "student_count": {
          "type": "number"
        }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profiles"
    },
    "/progress/{progressId}": {
      "schema": {
        "$ref": "#/entities/Progress"
      },
      "description": "User progress records"
    },
    "/metadata/{metadataId}": {
      "schema": {
        "$ref": "#/entities/Metadata"
      },
      "description": "Global metadata"
    }
  }
}
