{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and course progress",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "createdAt": { "type": "number", "description": "Timestamp of account creation" },
        "completedLessons": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid", "email", "role", "createdAt", "completedLessons"]
    },
    "Lesson": {
      "title": "Lesson",
      "description": "Course lesson metadata and video links",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "videoUrl": { "type": "string" },
        "pdfEnglish": { "type": "string" },
        "pdfHindi": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "coming_soon"] },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "videoUrl", "pdfEnglish", "pdfHindi", "status", "order"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": "User",
      "description": "Individual user profiles and progress"
    },
    "/lessons/{lessonId}": {
      "schema": "Lesson",
      "description": "Lesson content and video links"
    }
  }
}
